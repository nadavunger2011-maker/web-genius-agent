          "default": "trending-down"
        },
        { "type": "text", "id": "category_label", "label": "תווית קטגוריה", "default": "שליטה במשקל" },
        { "type": "textarea", "id": "quote", "label": "ציטוט" },
        { "type": "text", "id": "result", "label": "תוצאה" },
        { "type": "range", "id": "rating", "label": "דירוג", "min": 1, "max": 5, "default": 5 }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "סיפורי הצלחה (סליידר)",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "name": "הדר כהן",
