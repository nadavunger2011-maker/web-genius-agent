<section class="hero-carousel" data-carousel data-carousel-interval="5000" data-hero="pro">
  {% for block in section.blocks %}
    <div class="hero-carousel__slide {% if forloop.first %}is-active{% endif %}" data-carousel-slide {{ block.shopify_attributes }}>
      {% if block.settings.image %}
        <img class="hero-carousel__backdrop" src="{{ block.settings.image | image_url: width: 200 }}" alt="" aria-hidden="true" loading="lazy">
        <a href="{{ block.settings.link | default: '#products' }}" class="hero-carousel__slide-link">
          <img
            class="hero-carousel__image"
            src="{{ block.settings.image | image_url: width: 1920 }}"
            srcset="{{ block.settings.image | image_url: width: 768 }} 768w, {{ block.settings.image | image_url: width: 1280 }} 1280w, {{ block.settings.image | image_url: width: 1920 }} 1920w"
            sizes="100vw"
            alt="{{ block.settings.alt | escape }}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}
          >
          <div class="hero-carousel__slide-overlay"></div>
        </a>
      {% else %}
        <a href="{{ block.settings.link | default: '#products' }}" class="hero-carousel__placeholder"></a>
      {% endif %}
    </div>
  {% endfor %}

  <div class="container hero-carousel__content">
    <h1 class="hero-carousel__heading">{{ section.settings.heading }}</h1>
    <p class="hero-carousel__subtext">{{ section.settings.subtext }}</p>
  </div>

  {% if section.blocks.size > 1 %}
    <div class="hero-carousel__dots">
      {% for block in section.blocks %}
        <button type="button" class="hero-carousel__dot {% if forloop.first %}is-active{% endif %}" data-carousel-dot aria-label="שקופית {{ forloop.index }}"></button>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
.hero-carousel {
  position: relative;
  width: 100vw;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  height: 60vh;
  max-height: 760px;
  overflow: hidden;
  background: #000;
}

@media (min-width: 768px) {
  .hero-carousel {
    height: 80vh;
  }
}

.hero-carousel__slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  z-index: 0;
  transition: opacity 0.7s ease-in-out;
}

.hero-carousel__slide.is-active {
  opacity: 1;
  z-index: 1;
}

.hero-carousel__backdrop {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: blur(24px);
  opacity: 0.6;
  transform: scale(1.1);
}

.hero-carousel__slide-link {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
}

.hero-carousel__image {
  position: relative;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.hero-carousel__placeholder {
  position: absolute;
  inset: 0;
  display: block;
  background: var(--color-muted);
}

.hero-carousel__slide-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.4) 100%);
  pointer-events: none;
}

.hero-carousel__content {
  position: absolute;
  inset-inline: 0;
  bottom: 48px;
  z-index: 2;
  text-align: center;
  color: #fff;
  pointer-events: none;
}

@media (min-width: 768px) {
  .hero-carousel__content {
    bottom: 64px;
  }
}

.hero-carousel__heading {
  color: #fff;
  max-width: 900px;
  margin: 0 auto;
  filter: drop-shadow(0 4px 12px rgba(0,0,0,0.7));
}

.hero-carousel__subtext {
  color: rgba(255,255,255,0.9);
  font-size: 16px;
  font-weight: 600;
  max-width: 600px;
  margin: 12px auto 0;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,0.7));
}

@media (min-width: 768px) {
  .hero-carousel__subtext {
    font-size: 20px;
  }
}

.hero-carousel__dots {
  position: absolute;
  bottom: 16px;
  inset-inline: 0;
  display: flex;
  justify-content: center;
  gap: 8px;
  z-index: 3;
}

.hero-carousel__dot {
  width: 12px;
  height: 12px;
  border-radius: 9999px;
  background: rgba(255,255,255,0.5);
  border: none;
  padding: 0;
  transition: transform 0.2s ease, background 0.2s ease;
}

.hero-carousel__dot.is-active {
  background: #fff;
  transform: scale(1.25);
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero קרוסלה",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "התחילו את השינוי שלכם היום"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "טקסט משנה",
      "default": "תוספי תזונה ומוצרי Herbalife מקוריים — לאורח חיים בריא, אנרגטי ומאוזן"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "שקופית",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "תמונה"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "טקסט חלופי (alt)",
          "default": "פולבאדי - מוצרי הרבלייף מקוריים"
        },
        {
          "type": "url",
          "id": "link",
          "label": "קישור"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Hero קרוסלה",
      "blocks": [
        { "type": "slide", "settings": { "alt": "פולבאדי - מוצרי הרבלייף כשר למהדרין, אבקת חלבון H24 ותוספי תזונה לספורטאים" } },
        { "type": "slide", "settings": { "alt": "שייקי הרבלייף Formula 1 ואבקת חלבון H24 בכשר למהדרין - פולבאדי ישראל" } }
      ]
    }
  ]
}
{% endschema %}
