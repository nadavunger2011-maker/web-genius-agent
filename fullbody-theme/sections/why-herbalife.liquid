<section class="why-herbalife section-lg">
  <div class="container">
    <div class="why-herbalife__header">
      <h2>{{ section.settings.heading }}</h2>
      <p class="fb-text-secondary">{{ section.settings.subtext }}</p>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="why-herbalife__grid">
        {% for block in section.blocks %}
          <div class="why-herbalife__card card" {{ block.shopify_attributes }}>
            <div class="why-herbalife__icon-wrap">
              {% render 'icon', icon: block.settings.icon, size: 28 %}
            </div>
            <h3 class="fb-h3">{{ block.settings.title }}</h3>
            <p class="fb-text-secondary">{{ block.settings.text }}</p>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
.why-herbalife {
  background: color-mix(in srgb, var(--color-muted) 30%, var(--color-background));
}

.why-herbalife__header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 48px;
}

.why-herbalife__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}

@media (min-width: 768px) {
  .why-herbalife__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.why-herbalife__card {
  padding: 32px 24px;
  text-align: center;
  background: var(--color-card);
}

.why-herbalife__icon-wrap {
  width: 64px;
  height: 64px;
  border-radius: 9999px;
  background: rgba(var(--color-primary-rgb), 0.1);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
}

.why-herbalife__card h3 {
  margin-bottom: 8px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "למה הרבלייף",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "למה FullBody? המדע שמאחורי Herbalife Nutrition"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "טקסט משנה",
      "default": "מותג עולמי מוביל בתזונה מאוזנת ואורח חיים בריא, פועל ב-90 מדינות"
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "סיבה",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "אייקון",
          "options": [
            { "value": "leaf", "label": "עלה" },
            { "value": "dumbbell", "label": "משקולת" },
            { "value": "zap", "label": "ברק" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "title", "label": "כותרת", "default": "רכיבים טבעיים" },
        { "type": "textarea", "id": "text", "label": "תיאור", "default": "מוצרים מבוססי מדע עם רכיבים טבעיים ואיכותיים, ללא חומרים מיותרים." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "למה הרבלייף",
      "blocks": [
        { "type": "reason", "settings": { "icon": "leaf", "title": "רכיבים טבעיים", "text": "מוצרים מבוססי מדע עם רכיבים טבעיים ואיכותיים, ללא חומרים מיותרים." } },
        { "type": "reason", "settings": { "icon": "dumbbell", "title": "תזונת ספורט", "text": "קו מוצרי H24 לספורטאים — חלבון, אנרגיה וריהידרציה לביצועים מיטביים." } },
        { "type": "reason", "settings": { "icon": "zap", "title": "שליטה במשקל", "text": "תוכניות תזונה מוכחות לשליטה במשקל עם ליווי מקצועי ותוצאות." } }
      ]
    }
  ]
}
{% endschema %}
