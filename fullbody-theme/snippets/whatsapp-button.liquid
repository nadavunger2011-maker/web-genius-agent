{%- comment -%}
  Floating WhatsApp button — present site-wide in the source (WhatsAppButton.tsx)
  but NOT one of the 17 listed homepage sections. Kept as a floating element,
  same as the cart/search, and made toggleable via theme settings.
  Flagged in the final compromises report.
{%- endcomment -%}
<div class="whatsapp-fab" data-whatsapp-fab>
  <div class="whatsapp-fab__popup">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
      <strong>FullBody</strong>
    </div>
    <p class="fb-text-secondary" style="margin:0 0 12px;">
      היי! איך אפשר לעזור לך היום? 😊
    </p>
    <a href="{{ settings.whatsapp_link }}" target="_blank" rel="noopener" class="btn btn-primary" style="width:100%;background:#25D366;">
      התחל שיחה
    </a>
  </div>
  <a
    href="{{ settings.whatsapp_link }}"
    target="_blank"
    rel="noopener"
    class="whatsapp-fab__btn"
    data-whatsapp-fab-btn
    aria-label="פתח וואטסאפ"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="white">
