<section class="blog-articles section-lg">
  <div class="container">
    <div class="blog-articles__header">
      <h2>{{ section.settings.heading }}</h2>
      <p class="fb-text-secondary">{{ section.settings.subtext }}</p>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="blog-articles__grid">
        {% for block in section.blocks %}
          <a href="{{ block.settings.link | default: '#' }}" class="blog-articles__card card card-hover" {{ block.shopify_attributes }}>
            <div class="blog-articles__image-wrap">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" loading="lazy" width="600" height="338">
              {% else %}
                <div class="blog-articles__image-placeholder"></div>
              {% endif %}
            </div>
            <div class="blog-articles__body">
              <div class="blog-articles__meta">
                <span class="blog-articles__category">
                  {% render 'icon', icon: 'tag', size: 12 %}
                  {{ block.settings.category }}
                </span>
                <span class="blog-articles__date-time">
                  {{ block.settings.date }}
                  <span class="blog-articles__dot">•</span>
                  {% render 'icon', icon: 'clock', size: 12 %}
                  {{ block.settings.read_time }}
                </span>
              </div>
              <h3 class="blog-articles__title line-clamp-2">{{ block.settings.title }}</h3>
              <p class="blog-articles__excerpt line-clamp-2">{{ block.settings.excerpt }}</p>
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    <div class="blog-articles__footer">
      <a href="{{ section.settings.view_all_link | default: '#' }}" class="btn btn-outline">
        {{ section.settings.view_all_label }}
        {% render 'icon', icon: 'arrow-right', size: 16 %}
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
.blog-articles {
  background: color-mix(in srgb, var(--color-muted) 30%, var(--color-background));
}

.blog-articles__header {
  text-align: center;
  max-width: 600px;
  margin: 0 auto 48px;
}

.blog-articles__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}

@media (min-width: 768px) {
  .blog-articles__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.blog-articles__card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.blog-articles__image-wrap {
  width: 100%;
  aspect-ratio: 16 / 9;
  background: var(--color-muted);
  overflow: hidden;
}

.blog-articles__image-wrap img,
.blog-articles__image-placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.blog-articles__image-placeholder {
  background: var(--color-muted);
}

.blog-articles__body {
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}

.blog-articles__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 4px;
}

.blog-articles__category {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: rgba(var(--color-primary-rgb), 0.1);
  color: var(--color-primary);
  font-size: 12px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 9999px;
}

.blog-articles__date-time {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  color: var(--color-muted-foreground);
}

.blog-articles__dot {
  margin: 0 2px;
}

.blog-articles__title {
  font-weight: 700;
  font-size: 18px;
  color: var(--color-foreground);
  margin: 0;
}

.blog-articles__excerpt {
  font-size: 14px;
  line-height: 1.6;
  color: var(--color-muted-foreground);
  margin: 0;
}

.blog-articles__footer {
  text-align: center;
  margin-top: 40px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "בלוג",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "בלוג FullBody: ביו-האקינג, תזונת ספורט ואורח חיים בריא"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "טקסט משנה",
      "default": "טיפים, מדריכים ומידע מקצועי בנושאי תזונה, כושר ואורח חיים בריא"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "קישור לכל המאמרים"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "טקסט כפתור",
      "default": "לכל המאמרים"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "מאמר",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "תמונה" },
        { "type": "text", "id": "category", "label": "קטגוריה" },
        { "type": "text", "id": "date", "label": "תאריך" },
        { "type": "text", "id": "read_time", "label": "זמן קריאה", "default": "5 דק'" },
        { "type": "text", "id": "title", "label": "כותרת" },
        { "type": "textarea", "id": "excerpt", "label": "תקציר" },
        { "type": "url", "id": "link", "label": "קישור למאמר" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "בלוג",
      "blocks": [
        {
          "type": "article",
          "settings": {
            "category": "כושר ואימונים",
            "date": "28 במרץ 2026",
            "read_time": "7 דק'",
            "title": "חלבון לאחר אימון: המדריך המלא להתאוששות מיטבית",
            "excerpt": "מה הכמות הנכונה של חלבון אחרי אימון, מתי כדאי לצרוך אותו ואילו מקורות חלבון הכי יעילים להתאוששות השרירים."
          }
        },
        {
          "type": "article",
          "settings": {
            "category": "תזונה בריאה",
            "date": "25 במרץ 2026",
            "read_time": "6 דק'",
            "title": "שייקים תחליפי ארוחה: כל מה שצריך לדעת",
            "excerpt": "יתרונות, חסרונות וטיפים לשילוב נכון של שייקים תחליפי ארוחה בתפריט היומי שלכם לאורח חיים בריא ומאוזן."
          }
        },
        {
          "type": "article",
          "settings": {
            "category": "ניהול משקל",
            "date": "20 במרץ 2026",
            "read_time": "5 דק'",
            "title": "10 טיפים לניהול משקל בריא שעובדים",
            "excerpt": "אסטרטגיות מוכחות ומבוססות מדע לניהול משקל לטווח ארוך, ללא דיאטות קיצוניות וללא תחושת רעב מתמדת."
          }
        }
      ]
    }
  ]
}
{% endschema %}
