{% if section.blocks.size > 0 %}
  <section class="homepage-reviews section-md" aria-labelledby="latest-reviews-heading">
    <div class="container">
      <div class="homepage-reviews__header">
        <h2 id="latest-reviews-heading">{{ section.settings.heading }}</h2>
        <p class="fb-text-secondary">{{ section.settings.subtext }}</p>
      </div>

      <div class="homepage-reviews__grid">
        {% for block in section.blocks %}
          <a href="{{ block.settings.product_link | default: '#' }}" class="homepage-reviews__card" {{ block.shopify_attributes }}>
            <div class="homepage-reviews__stars">
              {% for i in (1..5) %}
                {% if i <= block.settings.rating %}
                  {% render 'icon', icon: 'star', size: 16, class: 'is-filled' %}
                {% else %}
                  {% render 'icon', icon: 'star', size: 16 %}
                {% endif %}
              {% endfor %}
            </div>
            {% if block.settings.title != blank %}
              <p class="homepage-reviews__title line-clamp-1">{{ block.settings.title }}</p>
            {% endif %}
            <p class="homepage-reviews__content line-clamp-3">{{ block.settings.content }}</p>
            <p class="homepage-reviews__reviewer">— {{ block.settings.reviewer_name }}</p>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
.homepage-reviews {
  background: var(--color-card);
  border-top: 1px solid var(--color-border);
}

.homepage-reviews__header {
  text-align: center;
  max-width: 600px;
  margin: 0 auto 32px;
}

.homepage-reviews__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}

@media (min-width: 768px) {
  .homepage-reviews__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.homepage-reviews__card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 20px;
  background: var(--color-background);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  transition: box-shadow 0.2s ease;
}

.homepage-reviews__card:hover {
  box-shadow: var(--shadow-card-hover);
}

.homepage-reviews__stars {
  display: flex;
  gap: 2px;
  color: var(--color-border);
}

.homepage-reviews__stars svg {
  fill: currentColor;
}

.homepage-reviews__stars svg.is-filled {
  color: var(--color-rating);
}

.homepage-reviews__title {
  font-weight: 700;
  color: var(--color-foreground);
  margin: 0;
}

.homepage-reviews__content {
  font-size: 14px;
  line-height: 1.6;
  color: var(--color-muted-foreground);
  margin: 0;
}

.homepage-reviews__reviewer {
  font-size: 12px;
  color: var(--color-muted-foreground);
  margin: auto 0 0;
  padding-top: 8px;
  border-top: 1px solid color-mix(in srgb, var(--color-border) 50%, transparent);
}
{% endstylesheet %}

{% schema %}
{
  "name": "ביקורות לקוחות",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "מה לקוחות אומרים עלינו"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "טקסט משנה",
      "default": "ביקורות אחרונות מלקוחות מאומתים"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "ביקורת",
      "settings": [
        { "type": "text", "id": "reviewer_name", "label": "שם הסוקר" },
        { "type": "range", "id": "rating", "label": "דירוג", "min": 1, "max": 5, "default": 5 },
        { "type": "text", "id": "title", "label": "כותרת הביקורת (לא חובה)" },
        { "type": "textarea", "id": "content", "label": "תוכן הביקורת" },
        { "type": "url", "id": "product_link", "label": "קישור למוצר" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "ביקורות לקוחות",
      "blocks": []
    }
  ]
}
{% endschema %}
